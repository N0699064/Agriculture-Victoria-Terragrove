# NewsAPI Configuration
# Get your free API key from: https://newsapi.org/register
NEWS_API_KEY=your-newsapi-key-here

# Email Configuration for Newsletter
# You can configure these with your actual email service credentials
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Optional: Custom news sources for better agriculture coverage
CUSTOM_NEWS_SOURCES=bbc-news,reuters,associated-press

# For production, you can use services like:
# - Gmail (with app password)
# - SendGrid
# - AWS SES
# - Mailgun
# etc.